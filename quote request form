```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>New Submission - Quote Request</title>

<style>
body{
    font-family:Arial,sans-serif;
    background:#f5f5f5;
    margin:0;
    padding:20px;
}

.container{
    max-width:900px;
    margin:auto;
    background:#fff;
    padding:30px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,.1);
}

h1,h2{
    color:#333;
}

.section{
    margin-bottom:30px;
}

label{
    display:block;
    margin-top:15px;
    font-weight:bold;
}

input[type=text],
input[type=email],
input[type=tel],
input[type=number],
input[type=date],
textarea,
select{
    width:100%;
    padding:12px;
    margin-top:5px;
    border:1px solid #ccc;
    border-radius:5px;
    box-sizing:border-box;
}

.checkbox-group{
    margin-top:10px;
}

.checkbox-group label{
    font-weight:normal;
}

button{
    margin-top:25px;
    background:#0066cc;
    color:white;
    border:none;
    padding:14px 30px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#0052a3;
}

.hidden{
    display:none;
}

.success{
    text-align:center;
    padding:50px;
}
</style>
</head>

<body>

<div class="container" id="formContainer">

<h1>Quote Request Form</h1>

<form id="quoteForm">

<h2>Your Details</h2>

<label>Name</label>
<input type="text" name="name" required>

<label>Telephone Number</label>
<input type="tel" name="phone" required>

<label>Email Address</label>
<input type="email" name="email" required>

<label>Full Address</label>
<textarea name="address" id="address" required></textarea>

<label>Postcode</label>
<input type="text" name="postcode" id="postcode" required>


<h2>Your Property</h2>

<label>What type of property needs cleaning?</label>
<select name="style" required>
<option value="">Select</option>
<option value="Semi">Semi-detached</option>
<option value="Detached">Detached</option>
<option value="Tera">Terraced</option>
<option value="Other">Other</option>
</select>

<label>How many windows are there?</label>
<input type="number" name="windows" min="1" required>

<label>What type of windows are they?</label>
<select name="size" required>
<option value="">Select</option>
<option value="Sml">Small</option>
<option value="Medium">Medium</option>
<option value="LRGE">Large</option>
</select>

<label>What needs cleaning this time?</label>
<select name="cleanType" required>
<option value="">Select</option>
<option value="Ext">Outside windows</option>
<option value="Ext + Doors">Outside windows and glass doors</option>
<option value="Int + Ext">Inside and outside windows</option>
<option value="All">Inside and outside windows and glass doors</option>
</select>

<label>How many stories are there?</label>
<input type="number" name="floors" min="1" required>

<label>Are there any roof windows?</label>
<select name="roofWindows" required>
<option value="">Select</option>
<option value="Yes">Yes</option>
<option value="No">No</option>
</select>

<label>Any other glass (e.g. glass balcony)?</label>
<select id="otherGlass" name="otherGlass" required>
<option value="">Select</option>
<option value="No">No</option>
<option value="Yes">Yes</option>
</select>

<div id="glassDescriptionWrap" class="hidden">
<label>Description</label>
<textarea name="glassDescription"></textarea>
</div>

<label>Are all windows easy to access?</label>
<select name="access" required>
<option value="">Select</option>
<option value="Yes">Yes</option>
<option value="Ladder/Scaff">No (ladder/scaffold required)</option>
</select>

<label>Are there any extras to include?</label>

<div class="checkbox-group">

<label>
<input type="checkbox" name="extras" value="None">
No - Standard windows/glass doors only
</label>

<label>
<input type="checkbox" name="extras" value="F">
Facias
</label>

<label>
<input type="checkbox" name="extras" value="S">
Soffits
</label>

<label>
<input type="checkbox" name="extras" value="SP">
Solar Panels
</label>

<label>
<input type="checkbox" name="extras" value="xSML">
One extra area
</label>

<label>
<input type="checkbox" name="extras" value="xM/L">
Medium/Large Conservatory or Multiple Skylights
</label>

</div>

<label>When was your property last cleaned?</label>
<input type="date" name="previousClean" required>

<label>How often would you like the clean?</label>

<select name="frequency" required>
<option value="">Select</option>
<option value="+12mnths">Intensive one-off clean</option>
<option value="6-12mnths">One-off clean</option>
<option value="4 weeks">Every 4 weeks</option>
<option value="6 weeks">Every 6 weeks</option>
<option value="8 weeks">Every 8 weeks</option>
<option value="12 weeks">Every 12 weeks</option>
</select>

<button type="submit">Request Quotation</button>

</form>

</div>

<script>

document.getElementById("otherGlass").addEventListener("change",function(){

const wrap=document.getElementById("glassDescriptionWrap");

if(this.value==="Yes"){
wrap.classList.remove("hidden");
}else{
wrap.classList.add("hidden");
}

});


document.getElementById("quoteForm").addEventListener("submit", async function(e){

e.preventDefault();

const form=this;

const formData=new FormData(form);

let extras=[];

document.querySelectorAll('input[name="extras"]:checked')
.forEach(cb=>extras.push(cb.value));

let extrasResult="";

const allValues=["None","F","S","SP","xSML","xM/L"];

if(allValues.every(v=>extras.includes(v))){
extrasResult="All";
}
else{
extrasResult=extras.join(" + ");
}

const payload={

name:formData.get("name"),
phone:formData.get("phone"),
email:formData.get("email"),
address:formData.get("address"),
postcode:formData.get("postcode"),

style:formData.get("style"),
windows:formData.get("windows"),
size:formData.get("size"),
cleanType:formData.get("cleanType"),
floors:formData.get("floors"),

roofWindows:formData.get("roofWindows"),

otherGlass:
formData.get("otherGlass")==="Yes"
?
"Yes - " + (formData.get("glassDescription") || "")
:
"No",

access:formData.get("access"),

extras:extrasResult,

previousClean:formData.get("previousClean"),

frequency:formData.get("frequency")
};

try{

const response=await fetch(
"https://YOUR_GOOGLE_APPS_SCRIPT_WEBAPP_URL",
{
method:"POST",
headers:{
"Content-Type":"application/json"
},
body:JSON.stringify(payload)
}
);

document.getElementById("formContainer").innerHTML=
`
<div class="success">
<h1>Thank You</h1>

<p>
Thank you for requesting a quotation.
</p>

<p>
Your submission has been received successfully.
</p>

<p>
A confirmation email has been sent and a member of our team will contact you shortly.
</p>
</div>
`;

}
catch(error){

alert("There was an error submitting your request.");

console.error(error);

}

});
</script>

</body>
</html>
```
